+    // ═══════════════════════════════════════════════════
+    // 反向烘焙辅助（镜像 AsciiLevelBaker 逻辑）
+    // ═══════════════════════════════════════════════════
+
+    private static readonly HashSet<char> MergeableTerrainChars = new HashSet<char> { '#', '=', '-' };
+
+    private static bool IsMergeableTerrain(char c) => MergeableTerrainChars.Contains(c);
+
+    private void BuildReverseMaps(
+        AsciiElementRegistry registry,
+        Dictionary<string, char> elementNameToChar,
+        Dictionary<string, char> componentTypeToChar)
+    {
+        if (registry.entries == null) return;
+
+        foreach (AsciiElementEntry entry in registry.entries)
+        {
+            if (entry == null) continue;
+
+            char asciiChar = entry.AsciiChar;
+            if (asciiChar == '\0') continue;
+
+            if (!string.IsNullOrEmpty(entry.elementName))
+                elementNameToChar[entry.elementName] = asciiChar;
+
+            if (entry.componentTypeNames == null) continue;
+
+            foreach (string typeName in entry.componentTypeNames)
+            {
+                if (string.IsNullOrWhiteSpace(typeName)) continue;
+                componentTypeToChar[typeName] = asciiChar;
+
+                int lastDot = typeName.LastIndexOf('.');
+                if (lastDot >= 0 && lastDot < typeName.Length - 1)
+                    componentTypeToChar[typeName.Substring(lastDot + 1)] = asciiChar;
+            }
+        }
+
+        if (!componentTypeToChar.ContainsKey("ControllablePlatform") &&
+            componentTypeToChar.TryGetValue("MovingPlatform", out char mpChar))
+        {
+            componentTypeToChar["ControllablePlatform"] = mpChar;
+        }
+    }
+
+    private char ResolveCharForObject(
+        GameObject obj,
+        Dictionary<string, char> elementNameToChar,
+        Dictionary<string, char> componentTypeToChar)
+    {
+        Component[] components = obj.GetComponents<Component>();
+        foreach (Component component in components)
+        {
+            if (component == null) continue;
+            Type componentType = component.GetType();
+            if (IsGenericUnityComponent(componentType)) continue;
+
+            if (componentTypeToChar.TryGetValue(componentType.Name, out char c1))
+                return c1;
+            if (!string.IsNullOrEmpty(componentType.FullName) &&
+                componentTypeToChar.TryGetValue(componentType.FullName, out char c2))
+                return c2;
+        }
+
+        foreach (KeyValuePair<string, char> pair in elementNameToChar)
+        {
+            if (NameMatchesElement(obj.name, pair.Key))
+                return pair.Value;
+        }
+
+        return '\0';
+    }
+
+    private static bool IsGenericUnityComponent(Type t)
+    {
+        return t == typeof(Transform) || t == typeof(Rigidbody2D) ||
+               t == typeof(BoxCollider2D) || t == typeof(CircleCollider2D) ||
+               t == typeof(PolygonCollider2D) || t == typeof(EdgeCollider2D) ||
+               t == typeof(CapsuleCollider2D) || t == typeof(SpriteRenderer) ||
+               t == typeof(Animator) || t == typeof(AudioSource);
+        }
+
+    private static bool NameMatchesElement(string objectName, string elementName)
+    {
+        if (string.IsNullOrEmpty(objectName) || string.IsNullOrEmpty(elementName))
+            return false;
+        if (string.Equals(objectName, elementName, StringComparison.Ordinal))
+            return true;
+        if (objectName.StartsWith(elementName + "_", StringComparison.Ordinal))
+            return true;
+        return objectName.StartsWith(elementName + " (", StringComparison.Ordinal);
+    }
+
+    private static int GetTerrainWidth(Transform obj)
+    {
+        if (TryParseWidthFromName(obj.name, out int w))
+            return Mathf.Max(1, w);
+
+        BoxCollider2D col = obj.GetComponent<BoxCollider2D>();
+        if (col != null && col.size.x > 1.5f)
+            return Mathf.Max(1, Mathf.RoundToInt(col.size.x));
+
+        return 1;
+    }
+
+    private static int GetTerrainStartX(Transform obj, int roundedX, int width)
+    {
+        if (width <= 1) return roundedX;
+        return Mathf.RoundToInt(obj.position.x - (width - 1) * 0.5f);
+    }
+
+    private static bool TryParseWidthFromName(string name, out int width)
+    {
+        width = 1;
+        int marker = name.LastIndexOf("_w", StringComparison.Ordinal);
+        if (marker < 0) return false;
+        int start = marker + 2;
+        int end = start;
+        while (end < name.Length && char.IsDigit(name[end])) end++;
+        return end > start && int.TryParse(name.Substring(start, end - start), out width);
+    }
+
+    private struct BakedEntry
+    {
+        public char asciiChar;
+        public int startX;
+        public int y;
+        public int width;
+    }
