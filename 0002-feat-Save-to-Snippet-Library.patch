+    private string GetLibrarySourcePath()
+    {
+        string relativePath = "Assets/Scripts/Editor/LevelSnippetLibrary.cs";
+        string fullPath = System.IO.Path.Combine(
+            System.IO.Path.GetDirectoryName(Application.dataPath),
+            relativePath);
+
+        if (!System.IO.File.Exists(fullPath))
+        {
+            // 尝试 FindAssets
+            string[] guids = AssetDatabase.FindAssets("LevelSnippetLibrary t:TextAsset");
+            if (guids != null && guids.Length > 0)
+            {
+                foreach (string guid in guids)
+                {
+                    string path = AssetDatabase.GUIDToAssetPath(guid);
+                    if (path.EndsWith("LevelSnippetLibrary.cs"))
+                    {
+                        fullPath = System.IO.Path.Combine(
+                            System.IO.Path.GetDirectoryName(Application.dataPath), path);
+                        break;
+                    }
+                }
+            }
+        }
+
+        if (!System.IO.File.Exists(fullPath))
+        {
+            EditorUtility.DisplayDialog("Save Failed",
+                $"\u672a\u627e\u5230 LevelSnippetLibrary.cs\u3002\n\u8def\u5f84: {fullPath}", "OK");
+            return null;
+        }
+
+        return fullPath;
+    }
