+    /// <summary>找到 InitSnippets() 方法体的最后一个 "));" 之后、方法闭合 "}" 之前的位置</summary>
+    private int FindInsertPositionForNewSnippet(string content)
+    {
+        // 找到 "private static void InitSnippets()" 方法
+        int methodStart = content.IndexOf("private static void InitSnippets()");
+        if (methodStart < 0)
+            methodStart = content.IndexOf("static void InitSnippets()");
+        if (methodStart < 0)
+            return -1;
+
+        // 找到方法体的开始 '{'
+        int braceStart = content.IndexOf('{', methodStart);
+        if (braceStart < 0) return -1;
+
+        // 找到方法体的闭合 '}'
+        int depth = 0;
+        int methodEnd = -1;
+        for (int i = braceStart; i < content.Length; i++)
+        {
+            char c = content[i];
+            if (c == '"')
+            {
+                i++;
+                while (i < content.Length)
+                {
+                    if (content[i] == '\\') { i++; }
+                    else if (content[i] == '"') { break; }
+                    i++;
+                }
+                continue;
+            }
+            if (c == '{') depth++;
+            else if (c == '}')
+            {
+                depth--;
+                if (depth == 0) { methodEnd = i; break; }
+            }
+        }
+
+        if (methodEnd < 0) return -1;
+
+        // 在方法闭合 '}' 之前插入
+        return methodEnd;
+    }
+
+    /// <summary>找到 Snippet 构造块的结束位置（包含外层 Add 的 ')'）</summary>
+    private int FindSnippetBlockEnd(string content, int startIndex)
+    {
+        // 找到 "snippets.Add(" 中的 '(' — 从 startIndex 往前找
+        int addStart = content.LastIndexOf("snippets.Add(", startIndex, Math.Min(startIndex, 200));
+        if (addStart < 0)
+            addStart = content.LastIndexOf("snippets.Add(", startIndex);
+        if (addStart < 0)
+        {
+            // 直接从 new Snippet 开始找
+            addStart = startIndex;
+        }
+
+        int firstParen = content.IndexOf('(', addStart);
+        if (firstParen < 0) return -1;
+
+        int depth = 0;
+        for (int i = firstParen; i < content.Length; i++)
+        {
+            char c = content[i];
+            if (c == '"')
+            {
+                i++;
+                while (i < content.Length)
+                {
+                    if (content[i] == '\\') { i++; }
+                    else if (content[i] == '"') { break; }
+                    i++;
+                }
+                continue;
+            }
+            if (c == '(') depth++;
+            else if (c == ')')
+            {
+                depth--;
+                if (depth == 0)
+                {
+                    // 找到外层 ')' 后找 ';'
+                    int j = i + 1;
+                    while (j < content.Length && char.IsWhiteSpace(content[j])) j++;
+                    if (j < content.Length && content[j] == ';')
+                        return j;
+                    return i;
+                }
+            }
+        }
+
+        return -1;
+    }
+
+    /// <summary>从 Snippet 构造块中提取命名参数的值</summary>
+    private string ExtractNamedParam(string block, string paramName)
+    {
+        string pattern = paramName + @"\s*:\s*""([^""]*)""";
+        Match m = Regex.Match(block, pattern);
+        return m.Success ? m.Groups[1].Value : "";
+    }
+
+    /// <summary>从 Snippet 构造块中提取位置参数（0=name, 1=description, 2=ascii）</summary>
+    private string ExtractPositionalParam(string block, int index)
+    {
+        // 简单提取第 N 个字符串字面量
+        MatchCollection matches = Regex.Matches(block, @"""([^""\\]*(?:\\.[^""\\]*)*)""");
+        if (matches.Count > index)
+            return matches[index].Groups[1].Value;
+        return "";
+    }
+
+    private string BuildAsciiLiteral(string ascii)
+    {
+        string[] lines = ascii.Split('\n');
+        if (lines.Length == 1)
+            return $"\"{EscapeCSharp(lines[0])}\"";
+
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < lines.Length; i++)
+        {
+            string line = lines[i].TrimEnd('\r');
+            if (i == 0)
+                sb.Append($"\"{EscapeCSharp(line)}\\n\" +\n");
+            else if (i == lines.Length - 1)
+                sb.Append($"            \"{EscapeCSharp(line)}\"");
+            else
+                sb.Append($"            \"{EscapeCSharp(line)}\\n\" +\n");
+        }
+        return sb.ToString();
+    }
+
+    private string EscapeCSharp(string input)
+    {
+        if (string.IsNullOrEmpty(input)) return "";
+        return input
+            .Replace("\\", "\\\\")
+            .Replace("\"", "\\\"")
+            .Replace("\n", "\\n")
+            .Replace("\r", "\\r")
+            .Replace("\t", "\\t");
+    }
+
+    private int CountLines(string text)
+    {
+        if (string.IsNullOrEmpty(text)) return 0;
+        return text.Split('\n').Length;
+    }
+
+    private void RefreshExistingSnippetNames()
+    {
+        List<LevelSnippetLibrary.Snippet> all = LevelSnippetLibrary.GetAllSnippets();
+        if (all == null || all.Count == 0)
+        {
+            existingSnippetNames = new string[0];
+            return;
+        }
+
+        existingSnippetNames = new string[all.Count];
+        for (int i = 0; i < all.Count; i++)
+        {
+            existingSnippetNames[i] = all[i] != null && !string.IsNullOrEmpty(all[i].name)
+                ? all[i].name : $"(unnamed #{i})";
+        }
+    }
