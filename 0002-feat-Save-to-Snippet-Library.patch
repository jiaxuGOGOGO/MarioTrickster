+#if UNITY_EDITOR
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.Reflection;
+using System.Text;
+using System.Text.RegularExpressions;
+using UnityEditor;
+using UnityEngine;
+
+/// <summary>
+/// Snippet Save Window — 将当前场景关卡反向导出为 ASCII 并存入 LevelSnippetLibrary。
+///
+/// 功能：
+///   1. 一键从场景 AsciiLevel_Root 烘焙 ASCII 模板（复用 AsciiLevelBaker 的反向解析逻辑）
+///   2. 支持"新增片段"或"替换已有片段"两种模式
+///   3. 自动将片段写入 LevelSnippetLibrary.cs 源文件并刷新
+///   4. 标签可后续通过 Validator 的 [Copy Tag Prompt] + [Apply Tags] 补充
+///
+/// 仅依赖项目内现有类，不引入外部库。
+/// </summary>
+public class SnippetSaveWindow : EditorWindow
+{
+    // ═══════════════════════════════════════════════════
+    // MenuItem 入口
+    // ═══════════════════════════════════════════════════
+
+    [MenuItem("MarioTrickster/Level Builder/Save Scene to Snippet Library")]
+    public static void ShowWindow()
+    {
+        SnippetSaveWindow window = GetWindow<SnippetSaveWindow>("Save to Snippet Library");
+        window.minSize = new Vector2(480f, 380f);
+        window.Show();
+    }
+
+    // ═══════════════════════════════════════════════════
+    // GUI 状态
+    // ═══════════════════════════════════════════════════
+
+    private const string GENERATED_ROOT_NAME = "AsciiLevel_Root";
+
+    private enum SaveMode { AddNew, ReplaceExisting }
+    private SaveMode saveMode = SaveMode.AddNew;
+
+    private string snippetName = "";
+    private string snippetDescription = "";
+    private string bakedAscii = "";
+    private bool hasBaked = false;
+
+    private int replaceIndex = 0;
+    private string[] existingSnippetNames;
+
+    private Vector2 asciiScrollPos;
+
+    // ═══════════════════════════════════════════════════
+    // OnGUI
+    // ═══════════════════════════════════════════════════
+
+    private void OnGUI()
+    {
+        EditorGUILayout.Space(10f);
+
+        GUIStyle titleStyle = new GUIStyle(EditorStyles.boldLabel)
+        {
+            fontSize = 15,
+            alignment = TextAnchor.MiddleCenter
+        };
+        EditorGUILayout.LabelField("Save Scene to Snippet Library", titleStyle);
+
+        GUIStyle subtitleStyle = new GUIStyle(EditorStyles.centeredGreyMiniLabel) { wordWrap = true };
+        EditorGUILayout.LabelField("\u573a\u666f\u5173\u5361 \u2192 ASCII \u2192 LevelSnippetLibrary\uff08\u65b0\u589e\u6216\u66ff\u6362\uff09", subtitleStyle);
+        EditorGUILayout.Space(8f);
+
+        // ── Step 1: Bake ──
+        EditorGUILayout.LabelField("", GUI.skin.horizontalSlider);
+        EditorGUILayout.LabelField("Step 1: \u70d8\u7119\u573a\u666f\u4e3a ASCII", EditorStyles.boldLabel);
+
+        Color oldBg = GUI.backgroundColor;
+        GUI.backgroundColor = new Color(0.3f, 0.7f, 1f);
+        if (GUILayout.Button("\ud83d\udd04 Bake Scene to ASCII", GUILayout.Height(30f)))
+        {
+            BakeCurrentScene();
+        }
+        GUI.backgroundColor = oldBg;
+
+        if (hasBaked)
+        {
+            EditorGUILayout.HelpBox($"ASCII \u5df2\u70d8\u7119\u6210\u529f\uff08{CountLines(bakedAscii)} \u884c\uff09\u3002\u53ef\u5728\u4e0b\u65b9\u9884\u89c8\u548c\u7f16\u8f91\u3002", MessageType.Info);
+
+            EditorGUILayout.LabelField("ASCII \u9884\u89c8 (\u53ef\u7f16\u8f91):", EditorStyles.miniLabel);
+            asciiScrollPos = EditorGUILayout.BeginScrollView(asciiScrollPos, GUILayout.Height(120f));
+            bakedAscii = EditorGUILayout.TextArea(bakedAscii, GUILayout.ExpandHeight(true));
+            EditorGUILayout.EndScrollView();
+        }
+        else
+        {
+            EditorGUILayout.HelpBox(
+                $"\u70b9\u51fb\u4e0a\u65b9\u6309\u94ae\uff0c\u5c06\u573a\u666f\u4e2d '{GENERATED_ROOT_NAME}' \u4e0b\u7684\u5173\u5361\u5143\u7d20\u53cd\u5411\u5bfc\u51fa\u4e3a ASCII \u6a21\u677f\u3002",
+                MessageType.None);
+        }
+
+        EditorGUILayout.Space(10f);
+
+        // ── Step 2: 配置 ──
+        EditorGUILayout.LabelField("", GUI.skin.horizontalSlider);
+        EditorGUILayout.LabelField("Step 2: \u914d\u7f6e\u4fdd\u5b58\u65b9\u5f0f", EditorStyles.boldLabel);
+
+        saveMode = (SaveMode)EditorGUILayout.EnumPopup("\u4fdd\u5b58\u6a21\u5f0f", saveMode);
+
+        if (saveMode == SaveMode.AddNew)
+        {
+            snippetName = EditorGUILayout.TextField("\u7247\u6bb5\u540d\u79f0", snippetName);
+            snippetDescription = EditorGUILayout.TextField("\u4e00\u53e5\u8bdd\u63cf\u8ff0", snippetDescription);
+        }
+        else
+        {
+            RefreshExistingSnippetNames();
+            if (existingSnippetNames != null && existingSnippetNames.Length > 0)
+            {
+                replaceIndex = EditorGUILayout.Popup("\u66ff\u6362\u76ee\u6807", replaceIndex, existingSnippetNames);
+            }
+            else
+            {
+                EditorGUILayout.HelpBox("\u7247\u6bb5\u5e93\u4e3a\u7a7a\uff0c\u65e0\u53ef\u66ff\u6362\u7684\u6a21\u677f\u3002", MessageType.Warning);
+            }
+            snippetDescription = EditorGUILayout.TextField("\u66f4\u65b0\u63cf\u8ff0 (\u53ef\u9009)", snippetDescription);
+        }
+
+        EditorGUILayout.Space(10f);
+
+        // ── Step 3: Save ──
+        EditorGUILayout.LabelField("", GUI.skin.horizontalSlider);
+
+        EditorGUI.BeginDisabledGroup(!hasBaked || string.IsNullOrEmpty(bakedAscii));
+        GUI.backgroundColor = new Color(0.3f, 0.85f, 0.4f);
+        if (GUILayout.Button("\u2705 Save to Snippet Library", GUILayout.Height(34f)))
+        {
+            ExecuteSave();
+        }
+        GUI.backgroundColor = oldBg;
+        EditorGUI.EndDisabledGroup();
+
+        EditorGUILayout.Space(6f);
+        EditorGUILayout.HelpBox(
+            "\u63d0\u793a\uff1a\u4fdd\u5b58\u540e\u6807\u7b7e\u4e3a\u7a7a\uff0c\u53ef\u7528 Validator \u9762\u677f\u7684 [Copy Tag Prompt] + [Apply Tags] \u8865\u5145\u3002",
+            MessageType.None);
+    }
+
+    // ═══════════════════════════════════════════════════
+    // Bake 逻辑（复用 AsciiLevelBaker 的核心算法）
+    // ═══════════════════════════════════════════════════
+
+    private void BakeCurrentScene()
+    {
+        string result = BakeSceneToAsciiString();
+        if (result == null)
+        {
+            hasBaked = false;
+            return;
+        }
+
+        bakedAscii = result.TrimEnd();
+        hasBaked = true;
+
+        // 自动填充片段名（如果为空）
+        if (string.IsNullOrEmpty(snippetName))
+        {
+            snippetName = $"Custom_{DateTime.Now:yyyyMMdd_HHmmss}";
+        }
+    }
+
+    /// <summary>
+    /// 将场景 AsciiLevel_Root 反向烘焙为 ASCII 字符串。
+    /// 核心逻辑与 AsciiLevelBaker.BakeSceneToAscii() 相同，但返回字符串而非写入剪贴板。
+    /// </summary>
+    private string BakeSceneToAsciiString()
+    {
+        GameObject root = GameObject.Find(GENERATED_ROOT_NAME);
+        if (root == null)
+        {
+            EditorUtility.DisplayDialog("Bake Failed",
+                $"\u573a\u666f\u4e2d\u672a\u627e\u5230 '{GENERATED_ROOT_NAME}'\u3002\u8bf7\u5148\u751f\u6210\u6216\u786e\u4fdd\u5173\u5361\u5143\u7d20\u5728\u8be5\u6839\u8282\u70b9\u4e0b\u3002", "OK");
+            return null;
+        }
+
+        if (root.transform.childCount == 0)
+        {
+            EditorUtility.DisplayDialog("Bake Failed",
+                $"'{GENERATED_ROOT_NAME}' \u4e0b\u6ca1\u6709\u5b50\u5bf9\u8c61\u3002", "OK");
+            return null;
+        }
+
+        AsciiElementRegistry registry = AsciiElementRegistry.GetDefault();
+        if (registry == null)
+        {
+            EditorUtility.DisplayDialog("Bake Failed",
+                "AsciiElementRegistry.GetDefault() \u8fd4\u56de null\uff0c\u65e0\u6cd5\u6784\u5efa\u53cd\u5411\u6620\u5c04\u3002", "OK");
+            return null;
+        }
+
+        registry.BuildCache();
+
+        // 构建反向映射
+        Dictionary<string, char> elementNameToChar = new Dictionary<string, char>(StringComparer.Ordinal);
+        Dictionary<string, char> componentTypeToChar = new Dictionary<string, char>(StringComparer.Ordinal);
+        BuildReverseMaps(registry, elementNameToChar, componentTypeToChar);
+
+        // 收集所有对象
+        List<BakedEntry> entries = new List<BakedEntry>();
+        int maxX = 0;
+        int maxY = 0;
+
+        foreach (Transform child in root.transform)
+        {
+            Vector2Int gridPos = new Vector2Int(
+                Mathf.RoundToInt(child.position.x),
+                Mathf.RoundToInt(child.position.y));
+
+            if (gridPos.x < 0 || gridPos.y < 0)
+                continue;
+
+            char asciiChar = ResolveCharForObject(child.gameObject, elementNameToChar, componentTypeToChar);
+            if (asciiChar == '\0' || asciiChar == '.')
+                continue;
+
+            bool mergeable = IsMergeableTerrain(asciiChar);
+            int width = mergeable ? Mathf.Max(1, GetTerrainWidth(child)) : 1;
+            int startX = mergeable ? GetTerrainStartX(child, gridPos.x, width) : gridPos.x;
+
+            if (startX < 0)
+                continue;
+
+            entries.Add(new BakedEntry
+            {
+                asciiChar = asciiChar,
+                startX = startX,
+                y = gridPos.y,
+                width = width
+            });
+
+            maxX = Mathf.Max(maxX, startX + width - 1);
+            maxY = Mathf.Max(maxY, gridPos.y);
+        }
+
+        if (entries.Count == 0)
+        {
+            EditorUtility.DisplayDialog("Bake Failed",
+                $"'{GENERATED_ROOT_NAME}' \u4e0b\u672a\u627e\u5230\u53ef\u8bc6\u522b\u7684 ASCII \u5143\u7d20\u3002", "OK");
+            return null;
+        }
+
+        // 填充网格
+        char[,] grid = new char[maxX + 1, maxY + 1];
+        bool[,] priority = new bool[maxX + 1, maxY + 1];
+        for (int y = 0; y <= maxY; y++)
+            for (int x = 0; x <= maxX; x++)
+            {
+                grid[x, y] = '.';
+                priority[x, y] = false;
+            }
+
+        foreach (BakedEntry entry in entries)
+        {
+            bool isPriority = !IsMergeableTerrain(entry.asciiChar);
+            for (int dx = 0; dx < entry.width; dx++)
+            {
+                int x = entry.startX + dx;
+                int y = entry.y;
+                if (x < 0 || x > maxX || y < 0 || y > maxY)
+                    continue;
+
+                if (isPriority || !priority[x, y])
+                {
+                    grid[x, y] = entry.asciiChar;
+                    priority[x, y] = isPriority;
+                }
+            }
+        }
+
+        // 输出（从上到下）
+        StringBuilder sb = new StringBuilder();
+        for (int y = maxY; y >= 0; y--)
+        {
+            for (int x = 0; x <= maxX; x++)
+                sb.Append(grid[x, y]);
+            if (y > 0)
+                sb.Append('\n');
+        }
+
+        return sb.ToString();
+    }
+
+    // ═══════════════════════════════════════════════════
+    // Save 逻辑
+    // ═══════════════════════════════════════════════════
+
+    private void ExecuteSave()
+    {
+        if (saveMode == SaveMode.AddNew)
+        {
+            if (string.IsNullOrEmpty(snippetName) || snippetName.Trim().Length == 0)
+            {
+                EditorUtility.DisplayDialog("Save Failed", "\u8bf7\u586b\u5199\u7247\u6bb5\u540d\u79f0\u3002", "OK");
+                return;
+            }
+
+            // 检查重名
+            List<LevelSnippetLibrary.Snippet> existing = LevelSnippetLibrary.GetAllSnippets();
+            if (existing != null)
+            {
+                foreach (LevelSnippetLibrary.Snippet s in existing)
+                {
+                    if (s != null && s.name == snippetName.Trim())
+                    {
+                        bool overwrite = EditorUtility.DisplayDialog("Name Conflict",
+                            $"\u5df2\u5b58\u5728\u540c\u540d\u7247\u6bb5 '{snippetName}'\u3002\u662f\u5426\u66ff\u6362\u5b83\uff1f",
+                            "Replace", "Cancel");
+                        if (!overwrite) return;
+                        // 转为替换模式
+                        ReplaceSnippetInSource(snippetName.Trim(), snippetDescription.Trim(), bakedAscii);
+                        return;
+                    }
+                }
+            }
+
+            AddNewSnippetToSource(snippetName.Trim(), snippetDescription.Trim(), bakedAscii);
+        }
+        else
+        {
+            if (existingSnippetNames == null || existingSnippetNames.Length == 0)
+            {
+                EditorUtility.DisplayDialog("Save Failed", "\u65e0\u53ef\u66ff\u6362\u7684\u6a21\u677f\u3002", "OK");
+                return;
+            }
+
+            string targetName = existingSnippetNames[replaceIndex];
+            bool confirmed = EditorUtility.DisplayDialog("Confirm Replace",
+                $"\u5c06\u66ff\u6362\u7247\u6bb5 '{targetName}' \u7684 ASCII \u5185\u5bb9\u3002\u539f\u6709\u6807\u7b7e\u5c06\u4fdd\u7559\u3002\n\n\u786e\u8ba4\uff1f",
+                "Replace", "Cancel");
+            if (!confirmed) return;
+
+            string desc = string.IsNullOrEmpty(snippetDescription) ? null : snippetDescription.Trim();
+            ReplaceSnippetInSource(targetName, desc, bakedAscii);
+        }
+    }
+
+    /// <summary>在 LevelSnippetLibrary.cs 末尾追加新片段</summary>
+    private void AddNewSnippetToSource(string name, string description, string ascii)
+    {
+        string sourcePath = GetLibrarySourcePath();
+        if (sourcePath == null) return;
+
+        string content = System.IO.File.ReadAllText(sourcePath, Encoding.UTF8);
+
+        // 找到 InitSnippets() 方法的最后一个 "));" 之后插入新片段
+        // 策略：在最后一个 "});" 或 "));" 之前的位置插入（在方法闭合 "}" 之前）
+        int insertPos = FindInsertPositionForNewSnippet(content);
+        if (insertPos < 0)
+        {
+            EditorUtility.DisplayDialog("Save Failed",
+                "\u672a\u80fd\u5728 LevelSnippetLibrary.cs \u4e2d\u5b9a\u4f4d\u63d2\u5165\u70b9\u3002", "OK");
+            return;
+        }
+
+        string escapedName = EscapeCSharp(name);
+        string escapedDesc = EscapeCSharp(description);
+        string escapedAscii = BuildAsciiLiteral(ascii);
+
+        string newSnippet =
+            "\n\n        // \u2500\u2500 (SnippetSaveWindow \u81ea\u52a8\u6dfb\u52a0) \u2500\u2500\n" +
+            "        snippets.Add(new Snippet(\n" +
+            $"            \"{escapedName}\",\n" +
+            $"            \"{escapedDesc}\",\n" +
+            $"            {escapedAscii}\n" +
+            "        ));\n";
+
+        string newContent = content.Substring(0, insertPos) + newSnippet + content.Substring(insertPos);
+        System.IO.File.WriteAllText(sourcePath, newContent, Encoding.UTF8);
+        AssetDatabase.Refresh();
+
+        // 运行时也立即添加
+        LevelSnippetLibrary.GetAllSnippets().Add(new LevelSnippetLibrary.Snippet(name, description, ascii));
+
+        EditorUtility.DisplayDialog("Save Successful",
+            $"\u2705 \u7247\u6bb5 '{name}' \u5df2\u6dfb\u52a0\u5230 LevelSnippetLibrary\u3002\n\n" +
+            "\u6807\u7b7e\u53ef\u7a0d\u540e\u901a\u8fc7 Validator \u9762\u677f\u8865\u5145\u3002", "OK");
+        Debug.Log($"[SnippetSaveWindow] \u2705 New snippet '{name}' added to LevelSnippetLibrary.cs");
+    }
+
+    /// <summary>替换已有片段的 ASCII 内容（保留标签）</summary>
+    private void ReplaceSnippetInSource(string targetName, string newDescription, string ascii)
+    {
+        string sourcePath = GetLibrarySourcePath();
+        if (sourcePath == null) return;
+
+        string content = System.IO.File.ReadAllText(sourcePath, Encoding.UTF8);
+
+        // 定位目标 Snippet
+        string escapedTargetName = Regex.Escape(targetName);
+        string pattern = @"new\s+Snippet\s*\(\s*\r?\n\s*""" + escapedTargetName + @"""";
+        Match match = Regex.Match(content, pattern);
+
+        if (!match.Success)
+        {
+            EditorUtility.DisplayDialog("Save Failed",
+                $"\u672a\u80fd\u5728\u6e90\u6587\u4ef6\u4e2d\u5b9a\u4f4d\u7247\u6bb5 '{targetName}'\u3002", "OK");
+            return;
+        }
+
+        int blockStart = match.Index;
+        int blockEnd = FindSnippetBlockEnd(content, blockStart);
+        if (blockEnd < 0)
+        {
+            EditorUtility.DisplayDialog("Save Failed",
+                $"\u672a\u80fd\u627e\u5230\u7247\u6bb5 '{targetName}' \u7684\u7ed3\u675f\u4f4d\u7f6e\u3002", "OK");
+            return;
+        }
+
+        string originalBlock = content.Substring(blockStart, blockEnd - blockStart + 1);
+
+        // 提取原有标签
+        string origMainRoute = ExtractNamedParam(originalBlock, "mainRoute");
+        string origShadowRoute = ExtractNamedParam(originalBlock, "shadowRoute");
+        string origTrapRoles = ExtractNamedParam(originalBlock, "trapRoles");
+        string origBudget = ExtractNamedParam(originalBlock, "budget");
+        string origTestGoal = ExtractNamedParam(originalBlock, "testGoal");
+
+        // 构建新块
+        string escapedName = EscapeCSharp(targetName);
+        string desc = newDescription ?? ExtractPositionalParam(originalBlock, 1);
+        string escapedDesc = EscapeCSharp(desc);
+        string escapedAscii = BuildAsciiLiteral(ascii);
+
+        StringBuilder sb = new StringBuilder();
+        sb.Append("new Snippet(\n");
+        sb.Append($"            \"{escapedName}\",\n");
+        sb.Append($"            \"{escapedDesc}\",\n");
+        sb.Append($"            {escapedAscii}");
+
+        // 保留原有标签
+        bool hasAnyTag = !string.IsNullOrEmpty(origMainRoute) || !string.IsNullOrEmpty(origShadowRoute) ||
+                         !string.IsNullOrEmpty(origTrapRoles) || !string.IsNullOrEmpty(origBudget) ||
+                         !string.IsNullOrEmpty(origTestGoal);
+        if (hasAnyTag)
+        {
+            sb.Append(",\n");
+            sb.Append($"            mainRoute: \"{EscapeCSharp(origMainRoute)}\",\n");
+            sb.Append($"            shadowRoute: \"{EscapeCSharp(origShadowRoute)}\",\n");
+            sb.Append($"            trapRoles: \"{EscapeCSharp(origTrapRoles)}\",\n");
+            sb.Append($"            budget: \"{EscapeCSharp(origBudget)}\",\n");
+            sb.Append($"            testGoal: \"{EscapeCSharp(origTestGoal)}\"");
+        }
+
+        sb.Append("\n        )");
+
+        // 检查原始块末尾是否有 ");"（外层 Add 的闭合）
+        string afterBlock = content.Substring(blockEnd + 1).TrimStart();
+        if (afterBlock.StartsWith(";"))
+        {
+            // 原始块包含了外层 ");", 我们需要保留
+        }
+
+        string newBlock = sb.ToString();
+
+        // 替换
+        string newContent = content.Substring(0, blockStart) + newBlock + content.Substring(blockEnd + 1);
+        System.IO.File.WriteAllText(newContent.Length > 0 ? sourcePath : sourcePath, newContent, Encoding.UTF8);
+        AssetDatabase.Refresh();
+
+        // 运行时更新
+        List<LevelSnippetLibrary.Snippet> allSnippets = LevelSnippetLibrary.GetAllSnippets();
+        if (allSnippets != null)
+        {
+            foreach (LevelSnippetLibrary.Snippet s in allSnippets)
+            {
+                if (s != null && s.name == targetName)
+                {
+                    s.ascii = ascii;
+                    if (newDescription != null)
+                        s.description = newDescription;
+                    // 重算宽高
+                    string[] lines = ascii.Split('\n');
+                    s.height = lines.Length;
+                    s.width = 0;
+                    foreach (string line in lines)
+                        if (line.Length > s.width) s.width = line.Length;
+                    break;
+                }
+            }
+        }
+
+        EditorUtility.DisplayDialog("Replace Successful",
+            $"\u2705 \u7247\u6bb5 '{targetName}' \u7684 ASCII \u5185\u5bb9\u5df2\u66f4\u65b0\u3002\n" +
+            (hasAnyTag ? "\u539f\u6709\u6807\u7b7e\u5df2\u4fdd\u7559\u3002" : "\u6807\u7b7e\u4e3a\u7a7a\uff0c\u53ef\u7a0d\u540e\u901a\u8fc7 Validator \u8865\u5145\u3002"), "OK");
+        Debug.Log($"[SnippetSaveWindow] \u2705 Snippet '{targetName}' replaced in LevelSnippetLibrary.cs");
+    }
