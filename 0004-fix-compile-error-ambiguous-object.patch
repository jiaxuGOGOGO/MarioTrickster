错误: 'Object' is an ambiguous reference between 'UnityEngine.Object' and 'object'
原因: 该文件同时 using System 和 UnityEngine，裸写 Object 产生歧义。
修复: Object.FindObjectOfType → UnityEngine.Object.FindObjectOfType
---
 Assets/Scripts/Editor/FullLevelValidatorWindow.cs | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Assets/Scripts/Editor/FullLevelValidatorWindow.cs b/Assets/Scripts/Editor/FullLevelValidatorWindow.cs
index ea102ef..0efdf77 100644
--- a/Assets/Scripts/Editor/FullLevelValidatorWindow.cs
+++ b/Assets/Scripts/Editor/FullLevelValidatorWindow.cs
@@ -419,7 +419,7 @@ public class FullLevelValidatorWindow : EditorWindow
         if (!report.hasMario)
         {
             // 检查场景中是否存在 MarioController 或 MarioSpawn 标记
-            if (Object.FindObjectOfType<MarioController>() != null)
+            if (UnityEngine.Object.FindObjectOfType<MarioController>() != null)
             {
                 report.hasMario = true;
                 report.marioCount = 1;
@@ -446,7 +446,7 @@ public class FullLevelValidatorWindow : EditorWindow
         if (!report.hasGoal)
         {
             // 检查场景中是否存在 GoalZone 组件
-            if (Object.FindObjectOfType<GoalZone>() != null)
+            if (UnityEngine.Object.FindObjectOfType<GoalZone>() != null)
             {
                 report.hasGoal = true;
                 report.goalCount = 1;
-- 
