<Project>
  <!-- Keep bin/obj of the verification harnesses out of the tracked tree (and out of Unity's view). -->
  <PropertyGroup>
    <WorldParkVerifyOut>$(MSBuildThisFileDirectory)..\..\.work\worldpark-verify\build\$(MSBuildProjectName)\</WorldParkVerifyOut>
    <BaseIntermediateOutputPath>$(WorldParkVerifyOut)obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(WorldParkVerifyOut)bin\</BaseOutputPath>
  </PropertyGroup>
</Project>
